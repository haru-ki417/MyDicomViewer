<Window x:Class="MyDicomViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyDicomViewer.ViewModels"
        xmlns:views="clr-namespace:MyDicomViewer.Views"
        xmlns:infra="clr-namespace:MyDicomViewer.Infrastructure"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MyDicomViewer"
        Height="820" Width="1360" MinWidth="1000" MinHeight="640"
        WindowState="Maximized"
        Background="{StaticResource Brush.Base}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFilesCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenFolderCommand}"/>
        <KeyBinding Key="Down" Command="{Binding NextSliceCommand}"/>
        <KeyBinding Key="PageDown" Command="{Binding NextSliceCommand}"/>
        <KeyBinding Key="Up" Command="{Binding PreviousSliceCommand}"/>
        <KeyBinding Key="PageUp" Command="{Binding PreviousSliceCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding ResetViewCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <infra:FractionToStarConverter x:Key="FractionToStar"/>

        <!-- 右パネルの各タブの余白 -->
        <Style x:Key="InspectorPage" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="20,18,20,20"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Brush.Line}"/>
            <Setter Property="Margin" Value="0,18"/>
        </Style>

        <!-- 結果が出たときだけ、ふわっと表示する（OS の「アニメーション効果」がオフなら即時） -->
        <Style x:Key="RevealOnResult" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasScreeningResult}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasScreeningResult}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===================================================== メニュー -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="ファイルを開く..." InputGestureText="Ctrl+O" Command="{Binding OpenFilesCommand}"/>
                <MenuItem Header="フォルダを開く..." InputGestureText="Ctrl+Shift+O" Command="{Binding OpenFolderCommand}"/>
                <Separator/>
                <MenuItem Header="AI の結果を DICOM で保存..." Command="{Binding SaveAiResultCommand}"/>
                <Separator/>
                <MenuItem Header="終了" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="全体表示に戻す" InputGestureText="Esc" Command="{Binding ResetViewCommand}"/>
                <MenuItem Header="DICOM タグ一覧" Command="{Binding ShowTagsCommand}"/>
                <MenuItem Header="計測を消去" Command="{Binding ClearMeasurementsCommand}"/>
            </MenuItem>
            <MenuItem Header="ツール(_T)">
                <MenuItem Header="設定..." Command="{Binding OpenSettingsCommand}"/>
                <MenuItem Header="ログフォルダを開く" Command="{Binding OpenLogFolderCommand}"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="使い方と注意事項" Command="{Binding ShowWelcomeCommand}"/>
                <MenuItem Header="更新を確認..." Command="{Binding CheckForUpdatesCommand}"/>
                <Separator/>
                <MenuItem Header="バージョン情報" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ===================================================== ツールバー -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Base}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource LogoMark}" Width="24" Height="24"/>
                    <TextBlock Text="MyDicomViewer" FontWeight="SemiBold" FontSize="14" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Tool}" Command="{Binding OpenFilesCommand}" ToolTip="DICOM ファイルを開く（Ctrl+O）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.File}"/>
                            <TextBlock Text="開く"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Tool}" Command="{Binding OpenFolderCommand}" ToolTip="フォルダごと読み込む。サブフォルダも探します（Ctrl+Shift+O）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}"/>
                            <TextBlock Text="フォルダ"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="{StaticResource Brush.Line}" Margin="10,0"/>

                    <RadioButton Style="{StaticResource Toggle.Tool}" GroupName="Tools" IsChecked="{Binding IsPanTool}" ToolTip="左ドラッグで画像を動かす">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Pan}"/>
                            <TextBlock Text="移動"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource Toggle.Tool}" GroupName="Tools" IsChecked="{Binding IsMeasureTool}" ToolTip="左ドラッグで距離を測る（画素間隔から mm で表示）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Measure}"/>
                            <TextBlock Text="計測"/>
                        </StackPanel>
                    </RadioButton>
                    <Button Style="{StaticResource Button.Tool}" Command="{Binding ClearMeasurementsCommand}" ToolTip="この画像の計測線をすべて消す">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Erase}"/>
                            <TextBlock Text="計測を消去"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="{StaticResource Brush.Line}" Margin="10,0"/>

                    <Button Style="{StaticResource Button.Tool}" Command="{Binding ResetViewCommand}" ToolTip="拡大・移動を元に戻す（Esc / 画像をダブルクリック）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Fit}"/>
                            <TextBlock Text="全体表示"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Tool}" Command="{Binding ShowTagsCommand}" ToolTip="DICOM タグをすべて表示・検索する">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Tags}"/>
                            <TextBlock Text="タグ"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 作業中のバー（読み込み・AI 解析・通信の間だけ表示） -->
        <Grid DockPanel.Dock="Top" Height="2" Background="{StaticResource Brush.Line}">
            <ProgressBar Style="{StaticResource ActivityBar}" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- ===================================================== ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Brush.Base}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="研究・学習用。診断には使用できません" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Caution}"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ===================================================== 本体（左: 検査 / 中央: 画像 / 右: 操作） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="360" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左: 検査とシリーズ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Panel}">
                <DockPanel>
                    <!-- 患者・検査 -->
                    <StackPanel DockPanel.Dock="Top" Margin="18,18,18,6" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PatientName}" Style="{StaticResource Text.Title}" ToolTip="{Binding PatientName}"/>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Readout}" Foreground="{StaticResource Brush.TextMuted}"
                                   Text="{Binding PatientId, StringFormat='ID {0}'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PatientId}"
                                   Visibility="{Binding ShowPatientIdLine, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="{StaticResource Brush.AccentTint}" CornerRadius="4" Padding="7,2">
                                <TextBlock Text="{Binding Modality}" Style="{StaticResource Text.Readout}" FontSize="12" Foreground="{StaticResource Brush.Accent}"/>
                            </Border>
                            <TextBlock Text="{Binding StudyDate}" Style="{StaticResource Text.Readout}" FontSize="12"
                                       Foreground="{StaticResource Brush.TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,16,0,12"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Series.Count, StringFormat='{}{0} 件'}" Style="{StaticResource Text.Readout}"
                                       FontSize="12" Foreground="{StaticResource Brush.TextFaint}" VerticalAlignment="Center"/>
                            <TextBlock Text="シリーズ" Style="{StaticResource Text.Section}" Margin="0"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- まだ何も開いていないとき -->
                    <StackPanel DockPanel.Dock="Top" Margin="18,24,18,0" Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="検査を開く" Style="{StaticResource Text.Title}"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,16"
                                   Text="DICOM ファイルかフォルダを開くと、シリーズ（撮影ごとの画像のまとまり）がここに並びます。画像の領域へのドラッグ＆ドロップでも開けます。"/>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenFolderCommand}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Folder}"/>
                                <TextBlock Text="フォルダを開く"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.File}"/>
                                <TextBlock Text="ファイルを開く"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Series}" SelectedItem="{Binding SelectedSeries}" Margin="10,4,10,12"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <!-- 1 人分の検査: シリーズの説明が見出し / 複数の患者: 患者が見出し -->
                                        <TextBlock x:Name="Heading" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Modality}" Style="{StaticResource Text.Readout}" FontSize="12" Foreground="{StaticResource Brush.Accent}"/>
                                            <TextBlock x:Name="Sub" Text="{Binding SeriesNumber, StringFormat='#{0}'}" Style="{StaticResource Text.Readout}" FontSize="12"
                                                       Foreground="{StaticResource Brush.TextFaint}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Files.Count, StringFormat='{}{0} 枚'}" Style="{StaticResource Text.Readout}"
                                               FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.HasMultiplePatients, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                        <Setter TargetName="Heading" Property="Text" Value="{Binding PatientLabel}"/>
                                        <Setter TargetName="Heading" Property="FontFamily" Value="{StaticResource Font.Readout}"/>
                                        <Setter TargetName="Heading" Property="ToolTip" Value="{Binding PatientLabel}"/>
                                        <Setter TargetName="Sub" Property="Text" Value="{Binding Title}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- 中央: 画像（スライスが複数あれば右端に縦のスライダー） -->
            <Grid Grid.Column="2" Background="{StaticResource Brush.Canvas}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <views:DicomViewport/>
                <Slider Grid.Column="1" Orientation="Vertical" IsDirectionReversed="True" Margin="6,16,10,16"
                        Minimum="0" Maximum="{Binding SliceMaximum}" Value="{Binding SliceIndex, Mode=TwoWay}"
                        IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                        Foreground="{StaticResource Brush.TextFaint}" ToolTip="スライス（ホイール・↑↓キーでも移動）"
                        Visibility="{Binding HasMultipleSlices, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- 右: 操作パネル -->
            <Border Grid.Column="4" Background="{StaticResource Brush.Panel}">
                <TabControl>
                    <!-- 画像 -->
                    <TabItem Header="画像">
                        <ScrollViewer Style="{StaticResource InspectorPage}">
                            <StackPanel IsEnabled="{Binding HasImage}">
                                <TextBlock Text="濃度" Style="{StaticResource Text.Section}"/>
                                <DockPanel Margin="0,4,0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WindowCenter, StringFormat={}{0:F0}}" Style="{StaticResource Text.Readout}"/>
                                    <TextBlock Text="ウィンドウ中心（明るさ）" Style="{StaticResource Text.Label}"/>
                                </DockPanel>
                                <Slider Minimum="{Binding WindowCenterMinimum}" Maximum="{Binding WindowCenterMaximum}" Value="{Binding WindowCenter, Mode=TwoWay}"/>
                                <DockPanel Margin="0,12,0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WindowWidth, StringFormat={}{0:F0}}" Style="{StaticResource Text.Readout}"/>
                                    <TextBlock Text="ウィンドウ幅（コントラスト）" Style="{StaticResource Text.Label}"/>
                                </DockPanel>
                                <Slider Minimum="1" Maximum="{Binding WindowWidthMaximum}" Value="{Binding WindowWidth, Mode=TwoWay}"/>
                                <TextBlock Text="プリセット" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
                                <ComboBox ItemsSource="{Binding WindowPresets}" SelectedItem="{Binding SelectedPreset}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                           Text="画像の上で右ドラッグしても調整できます（横: 幅、縦: 中心）。"/>

                                <Border Style="{StaticResource Divider}"/>

                                <TextBlock Text="計測" Style="{StaticResource Text.Section}"/>
                                <TextBlock Text="{Binding PixelSpacingText}" Style="{StaticResource Text.Label}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                           Text="ツールバーの「計測」を選び、画像の上をドラッグします。計測線はスライスを切り替えると消えます。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- オンデバイス AI -->
                    <TabItem Header="AI 解析">
                        <ScrollViewer Style="{StaticResource InspectorPage}">
                            <StackPanel>
                                <TextBlock Text="肺炎スクリーニング" Style="{StaticResource Text.Section}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,14"
                                           Text="胸部X線（CR / DX）から肺炎所見の確率を推定し、判断の根拠をヒートマップで示します。処理は PC の中だけで行い、画像は外部に送信しません。"/>
                                <Button Style="{StaticResource Button.Ai}" Content="{Binding ScreeningButtonText}" Command="{Binding RunScreeningCommand}"/>

                                <!-- 結果: 確率と判定閾値を1本の目盛りで示す -->
                                <Border Style="{StaticResource RevealOnResult}" Margin="0,18,0,0" Padding="16,14"
                                        Background="{StaticResource Brush.AiTint}" CornerRadius="8"
                                        Visibility="{Binding HasScreeningResult, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="肺炎所見の推定確率" Style="{StaticResource Text.Label}"/>
                                        <TextBlock Text="{Binding ScreeningProbability}" Style="{StaticResource Text.ReadoutLarge}" Margin="0,2,0,8"/>

                                        <!-- 目盛り: 塗り = 確率 / 縦線 = 判定閾値 -->
                                        <Grid Height="22">
                                            <Border Height="6" CornerRadius="3" Background="{StaticResource Brush.Line}" VerticalAlignment="Center"/>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding ProbabilityFraction, Converter={StaticResource FractionToStar}}"/>
                                                    <ColumnDefinition Width="{Binding ProbabilityFraction, Converter={StaticResource FractionToStar}, ConverterParameter=Remainder}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Height="6" CornerRadius="3" Background="{Binding ScreeningVerdictColor}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding ThresholdFraction, Converter={StaticResource FractionToStar}}"/>
                                                    <ColumnDefinition Width="{Binding ThresholdFraction, Converter={StaticResource FractionToStar}, ConverterParameter=Remainder}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="2" CornerRadius="1" Background="{StaticResource Brush.Text}" HorizontalAlignment="Right" Margin="0,0,-1,0"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ThresholdFraction, Converter={StaticResource FractionToStar}}"/>
                                                <ColumnDefinition Width="{Binding ThresholdFraction, Converter={StaticResource FractionToStar}, ConverterParameter=Remainder}"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.ColumnSpan="2" Text="0%" Style="{StaticResource Text.Readout}" FontSize="11" Foreground="{StaticResource Brush.TextFaint}"/>
                                            <TextBlock Grid.ColumnSpan="2" Text="100%" Style="{StaticResource Text.Readout}" FontSize="11" Foreground="{StaticResource Brush.TextFaint}" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ThresholdText}" Style="{StaticResource Text.Readout}" FontSize="11"
                                                       Foreground="{StaticResource Brush.TextMuted}" Margin="-30,0,0,0" HorizontalAlignment="Left"/>
                                        </Grid>

                                        <TextBlock Text="{Binding ScreeningVerdict}" Foreground="{Binding ScreeningVerdictColor}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                                        <TextBlock Text="{Binding ScreeningDetail}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Divider}"/>

                                <TextBlock Text="ヒートマップ" Style="{StaticResource Text.Section}"/>
                                <CheckBox Content="画像に重ねて表示する" IsChecked="{Binding ShowHeatmap}" IsEnabled="{Binding HasScreeningResult}"/>
                                <TextBlock Text="{Binding HeatmapNote}" Margin="27,6,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNegativeHeatmapShown}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Caution}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <DockPanel Margin="0,14,0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding HeatmapOpacity, StringFormat={}{0:P0}}" Style="{StaticResource Text.Readout}"/>
                                    <TextBlock Text="濃さ" Style="{StaticResource Text.Label}"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding HeatmapOpacity, Mode=TwoWay}" Foreground="{StaticResource Brush.Ai}"/>
                                <Button Command="{Binding SaveAiResultCommand}" Margin="0,16,0,0"
                                        ToolTip="元画像にヒートマップを重ねた画像を、同じ検査の新しいシリーズ（二次取込画像）として保存します。PACS や他のビューアでも開けます。">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Save}"/>
                                        <TextBlock Text="結果を DICOM で保存"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Caution}" Margin="0,18,0,0"
                                           Text="研究・学習目的のデモです。医療機器ではなく、診断には使用できません。ヒートマップは判断の根拠の候補であり、医学的な正しさを保証するものではありません。"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 生成 AI レポート -->
                    <TabItem Header="レポート">
                        <ScrollViewer Style="{StaticResource InspectorPage}">
                            <StackPanel>
                                <TextBlock Text="読影レポートの下書き" Style="{StaticResource Text.Section}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,14"
                                           Text="表示中の画像を生成 AI（OpenAI）に送り、レポートの下書きを作ります。患者 ID は送信しません。"/>
                                <Button Style="{StaticResource Button.Primary}" Content="{Binding ReportButtonText}" Command="{Binding GenerateReportCommand}"/>
                                <TextBox Text="{Binding ReportText, Mode=OneWay}" Margin="0,14,0,0" MinHeight="320" TextWrapping="Wrap" AcceptsReturn="True"
                                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="12.5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- クラウド -->
                    <TabItem Header="クラウド">
                        <ScrollViewer Style="{StaticResource InspectorPage}">
                            <StackPanel>
                                <TextBlock Text="保存" Style="{StaticResource Text.Section}"/>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,14"
                                           Text="患者名・生年月日などを DICOM 規格（PS3.15）に沿って削除し、仮の ID を付けてから Azure に保存します。"/>
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding UploadCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Upload}"/>
                                        <TextBlock Text="匿名化して保存"/>
                                    </StackPanel>
                                </Button>

                                <Border Style="{StaticResource Divider}"/>

                                <TextBlock Text="検索と取得" Style="{StaticResource Text.Section}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" ToolTip="仮の ID（ID-…）の一部で検索。空欄ならすべて">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,6" Command="{Binding SearchCommand}" ToolTip="検索（Enter）">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Search}" Margin="0"/>
                                    </Button>
                                </Grid>
                                <ListView ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" Height="220" Margin="0,10,0,0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="仮の ID" DisplayMemberBinding="{Binding PatientId}" Width="120"/>
                                            <GridViewColumn Header="種類" DisplayMemberBinding="{Binding Modality}" Width="50"/>
                                            <GridViewColumn Header="保存日時" DisplayMemberBinding="{Binding UploadedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Width="120"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Button Command="{Binding DownloadCommand}" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource Icon.Download}"/>
                                        <TextBlock Text="選んだ画像を開く"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
