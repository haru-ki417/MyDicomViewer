<Window x:Class="MyDicomViewer.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="32,28,32,24">
        <StackPanel Orientation="Horizontal">
            <ContentControl Style="{StaticResource LogoMark}" Width="48" Height="48"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MyDicomViewer" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Text.Readout}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="CopyrightText" Style="{StaticResource Text.Caption}" Margin="0,16,0,0"/>

        <TextBlock Text="AI モデル" Style="{StaticResource Text.Section}" Margin="0,22,0,6"/>
        <TextBlock x:Name="ModelText" Style="{StaticResource Text.Label}" TextWrapping="Wrap" LineHeight="20"/>

        <TextBlock Text="オープンソースソフトウェア" Style="{StaticResource Text.Section}" Margin="0,22,0,6"/>
        <TextBlock Style="{StaticResource Text.Label}" TextWrapping="Wrap" LineHeight="20"
                   Text="fo-dicom / fo-dicom.Codecs (MS-PL)、ONNX Runtime (MIT)、CommunityToolkit.Mvvm (MIT)、Velopack (MIT)、Azure SDK for .NET (MIT)、OpenAI .NET (MIT)、Newtonsoft.Json (MIT)、Microsoft.Extensions.* (MIT)。AI モデルは torchvision (BSD-3-Clause) の ImageNet 学習済み EfficientNet-B0 をもとに学習しています。詳しくは THIRD_PARTY_NOTICES.md を参照してください。"/>

        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Caution}" Margin="0,18,0,0"
                   Text="研究・学習目的のソフトウェアです。医療機器ではなく、診断に使用することはできません。"/>

        <DockPanel Margin="0,22,0,0">
            <Button DockPanel.Dock="Right" Content="閉じる" MinWidth="100" IsCancel="True" IsDefault="True"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock>
                    <Hyperlink x:Name="RepositoryLink" Foreground="{StaticResource Brush.Accent}" RequestNavigate="Link_RequestNavigate">GitHub リポジトリ</Hyperlink>
                </TextBlock>
                <TextBlock Margin="18,0,0,0">
                    <Hyperlink x:Name="ModelCardLink" Foreground="{StaticResource Brush.Accent}" RequestNavigate="Link_RequestNavigate">モデルカード</Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
