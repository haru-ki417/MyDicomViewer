<Window x:Class="MyDicomViewer.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyDicomViewer へようこそ" Width="620" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="32,28,32,24">
        <StackPanel Orientation="Horizontal">
            <ContentControl Style="{StaticResource LogoMark}" Width="40" Height="40"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="MyDicomViewer" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="AI 搭載 DICOM ビューア" Style="{StaticResource Text.Label}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="できること" Style="{StaticResource Text.Section}" Margin="0,26,0,8"/>
        <TextBlock TextWrapping="Wrap" LineHeight="23" Foreground="{StaticResource Brush.TextMuted}"
                   Text="DICOM のファイルやフォルダを開き、シリーズごとに表示します。濃度の調整、距離の計測、タグの確認ができます。胸部X線では、PC 内の AI が肺炎所見の確率を推定し、根拠をヒートマップで示します。設定をすれば、匿名化したうえでクラウドに保存することもできます。"/>

        <Border Background="#2B2418" BorderBrush="#5C4A2A" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,22,0,0">
            <StackPanel>
                <TextBlock Text="ご利用にあたって" FontWeight="SemiBold" Foreground="{StaticResource Brush.Caution}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#E9DCC6"
                           Text="本ソフトウェアは研究・学習を目的としたものであり、医療機器ではありません。AI の結果を含め、表示される情報を診断・治療の判断に使用しないでください。AI は誤った結果を出すことがあり、陰性の結果は異常がないことを意味しません。"/>
            </StackPanel>
        </Border>

        <CheckBox x:Name="AcceptCheck" Margin="0,18,0,0" Checked="AcceptCheck_Changed" Unchecked="AcceptCheck_Changed">
            <TextBlock Text="上記を理解し、診断目的では使用しないことに同意します" TextWrapping="Wrap"/>
        </CheckBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="DeclineButton" Content="同意せずに終了" MinWidth="130" Margin="0,0,10,0" Click="DeclineButton_Click"/>
            <Button x:Name="StartButton" Style="{StaticResource Button.Primary}" Content="はじめる" MinWidth="120" IsDefault="True" IsEnabled="False" Click="StartButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
